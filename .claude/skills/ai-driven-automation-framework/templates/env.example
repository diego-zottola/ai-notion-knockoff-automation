# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration template
# Copy this file to .env.local (local dev) or .env.<env> (uat/qa/staging/production)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the application under test
BASE_URL={{DEV_URL}}

# Environment label (used for reporting context and dotenv file selection)
ENV=local

# Primary role credentials
TEST_USER_EMAIL={{TEST_EMAIL}}
TEST_USER_PASSWORD={{TEST_PASSWORD}}

# ── Self-healing locators (Tier 3 LLM) ───────────────────────────────────────
# HEAL_CONFIDENCE_THRESHOLD=0.80   # 0.0-1.0, default 0.80
# ANTHROPIC_API_KEY=your-api-key   # required for Tier 3 self-healing

# ── Risk-based test selection (only if templates/orchestrator/ was copied) ──
# RISK_BASE_REF=origin/main        # base branch for diff comparison
# RISK_MIN_COVERAGE_RATIO=0.10     # safety net — run all if selection < 10% of suite

# ── Data Agent ──────────────────────────────────────────────────────────────
# DATA_TEST_PREFIX=qa-auto-        # prefix for all generated test data
# DATA_CLEANUP_STRATEGY=after-each # after-each | after-all | manual

# ── Visual regression ────────────────────────────────────────────────────────
# VISUAL_REGRESSION_ENABLED=false  # opt-in — set true to enable
# VISUAL_UPDATE_BASELINES=false    # set true to regenerate baselines
# VISUAL_THRESHOLD=0.02            # allowed diff ratio (0.02 = 2%)
# VISUAL_BASELINE_DIR=visual/baselines
# VISUAL_DIFF_DIR=visual/diffs

# ── Optional: second role (only if step 0 named additional roles) ───────────
# ADMIN_BASE_URL={{ADMIN_DEV_URL}}
# ADMIN_USER_EMAIL=
# ADMIN_USER_PASSWORD=

# ── Optional: direct DB access (only if utils/db.js was copied) ─────────────
# Each prefix maps to createDbClient('PREFIX_') — add as many as needed.
# DB_HOST=
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=
#
# QA_DB_HOST=
# QA_DB_PORT=5432
# QA_DB_USERNAME=
# QA_DB_PASSWORD=
# QA_DB_DATABASE=

# ── Optional: email-verification testing (only if utils/email.js was copied) ─
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# ── Optional: k6 performance testing (only if performance-tests/ was copied) ─
# API_BASE_DEV=
# API_BASE_QA=
# API_BASE_UAT=
# LOGIN_PATH=/auth/login

# ── Optional: CI Slack notifications (only if requested in step 0) ──────────
# Not read from here — set as a GitHub Actions secret (SLACK_WEBHOOK_URL), never in a committed file.

# ── Optional: Work Management Connector (only if templates/connectors/ was copied) ──
# WORK_MANAGEMENT_PROVIDER=jira
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=YOUR_PROJECT
# JIRA_READY_FOR_QA_STATUS=Ready for QA

# ── Optional: ChatOps Connector (only if templates/connectors/ was copied) ──
# CHATOPS_PROVIDER=slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_SIGNING_SECRET=your-signing-secret
# SLACK_CHANNEL=#qa-automation

# ── Memory / RAG ─────────────────────────────────────────────────────────────
# MEMORY_DIR=.qa-memory             # persistent memory directory
# MEMORY_FILE=memory.jsonl          # memory store filename
