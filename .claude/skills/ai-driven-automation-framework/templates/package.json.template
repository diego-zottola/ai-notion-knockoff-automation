// Merge into the new project's package.json — add allure-playwright, allure-commandline,
// dotenv, @playwright/test, @playwright/mcp to devDependencies.
{
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install --with-deps",
    "test": "rm -rf allure-results && npx playwright test --project=chromium && npm run allure",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "allure": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report --port 3030"
  }
}

